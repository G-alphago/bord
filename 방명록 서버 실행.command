#!/bin/zsh

# 사용자의 터미널 환경 설정을 불러와서 Node.js(npm) 경로를 인식하도록 합니다.
export PATH="/usr/local/bin:/opt/homebrew/bin:$PATH"
source ~/.zshrc 2>/dev/null

echo "================================================="
echo "      2026 중고등부 학생수련회 방명록 서버       "
echo "================================================="
echo "서버를 기동하는 중입니다. 잠시만 기다려주세요..."
echo "(서버를 종료하시려면 이 터미널 창을 닫으시면 됩니다)"
echo "================================================="

# 현재 스크립트가 위치한 폴더로 이동합니다.
cd "$(dirname "$0")"

# 서버 실행
npm start
